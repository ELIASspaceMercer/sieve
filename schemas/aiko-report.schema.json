{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/true-altruist/sieve/blob/main/schemas/aiko-report.schema.json",
  "title": "SIEVE AIKO report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "created_on", "artefact", "assess", "inspect", "keep_accountable", "observe"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "report_id": {"$ref": "#/$defs/text"},
    "created_on": {"$ref": "#/$defs/date"},
    "artefact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "location", "type", "diff_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "revision": {"$ref": "#/$defs/text"},
        "location": {"$ref": "#/$defs/text"},
        "type": {"$ref": "#/$defs/text"},
        "diff_ref": {"$ref": "#/$defs/text"},
        "use_on": {"$ref": "#/$defs/date"}
      }
    },
    "assess": {
      "type": "object", "additionalProperties": false,
      "required": ["context_ref", "source_of_truth", "data_classification", "trust_boundaries", "review_class", "risk_flags", "review_budget_minutes"],
      "properties": {
        "context_ref": {"$ref": "#/$defs/text"},
        "source_of_truth": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "data_classification": {"enum": ["public", "internal", "confidential"]},
        "trust_boundaries": {"$ref": "#/$defs/text"},
        "review_class": {"enum": ["reversible_private", "reversible_public", "irreversible_or_load_bearing", "legally_or_contractually_operative"]},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["authentication", "payments", "personal_data", "other"]}},
        "review_budget_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "inspect": {
      "type": "object", "additionalProperties": false,
      "required": ["automated_checks", "claims", "verification_surface_ref"],
      "properties": {
        "automated_checks": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "tool", "status"],
            "properties": {
              "id": {"$ref": "#/$defs/text"}, "tool": {"$ref": "#/$defs/text"},
              "status": {"enum": ["passed", "failed", "not_run"]},
              "evidence_ref": {"$ref": "#/$defs/text"}, "checked_on": {"$ref": "#/$defs/date"}
            },
            "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"required": ["evidence_ref", "checked_on"]}}]
          }
        },
        "claims": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "statement", "source_ref", "status"],
            "properties": {
              "id": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"},
              "source_ref": {"$ref": "#/$defs/text"}, "status": {"enum": ["verified", "unverified"]},
              "evidence_ref": {"$ref": "#/$defs/text"}, "checked_on": {"$ref": "#/$defs/date"}
            },
            "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"required": ["evidence_ref", "checked_on"]}}]
          }
        },
        "verification_surface_ref": {"$ref": "#/$defs/text"}
      }
    },
    "keep_accountable": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "human_reviews", "open_items"],
      "properties": {
        "owner": {"$ref": "#/$defs/text"},
        "human_reviews": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "reviewer", "decision"],
            "properties": {
              "role": {"enum": ["primary", "independent"]},
              "reviewer": {"$ref": "#/$defs/text"},
              "decision": {"enum": ["pending", "approved", "rejected"]},
              "reviewed_on": {"$ref": "#/$defs/date"},
              "evidence_ref": {"$ref": "#/$defs/text"}
            },
            "allOf": [{"if": {"properties": {"decision": {"const": "approved"}}}, "then": {"required": ["reviewed_on", "evidence_ref"]}}]
          }
        },
        "open_items": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "description", "owner", "status"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "description": {"$ref": "#/$defs/text"},
              "owner": {"$ref": "#/$defs/text"},
              "status": {"enum": ["open", "accepted", "resolved"]},
              "expiry_on": {"$ref": "#/$defs/date"},
              "decision_ref": {"$ref": "#/$defs/text"},
              "accepted_by": {"$ref": "#/$defs/text"}
            },
            "allOf": [
              {"if": {"properties": {"status": {"enum": ["open", "accepted"]}}}, "then": {"required": ["expiry_on"]}},
              {"if": {"properties": {"status": {"const": "accepted"}}}, "then": {"required": ["decision_ref", "accepted_by"]}}
            ]
          }
        }
      }
    },
    "observe": {
      "type": "object", "additionalProperties": false,
      "required": ["verifications"],
      "properties": {
        "verifications": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "claim_ref", "checked_on", "recheck_by", "owner", "status", "schedule_ref"],
            "properties": {
              "id": {"$ref": "#/$defs/text"}, "claim_ref": {"$ref": "#/$defs/text"},
              "checked_on": {"$ref": "#/$defs/date"}, "recheck_by": {"$ref": "#/$defs/date"},
              "owner": {"$ref": "#/$defs/text"}, "status": {"enum": ["current", "changed", "withdrawn"]},
              "schedule_ref": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
